+void ClientSocket::SetButtons(std::string_view args, u32 port)
+{
+  Controller* const controller = Pad::GetController(port);
+  if (!controller)
+  {
+    SendError("pad 1 controller is not connected");
+    return;
+  }
+
+  while (!args.empty())
+  {
+    args = Trim(args);
+    const size_t end = args.find(' ');
+    const std::string_view token = args.substr(0, end);
+    args = (end == std::string_view::npos) ? std::string_view() : args.substr(end + 1);
+    if (token.empty())
+      continue;
+
+    const size_t equals = token.find('=');
+    if (equals == std::string_view::npos)
+    {
+      SendError("button tokens must be Name=value");
+      return;
+    }
+
+    const std::string_view name = token.substr(0, equals);
+    const std::string_view raw_value = token.substr(equals + 1);
+    const std::optional<float> parsed_value = StringUtil::FromChars<float>(raw_value);
+    if (!parsed_value.has_value())
+    {
+      SendError("invalid button value");
+      return;
+    }
+
+    if (const std::optional<u32> button = GetButtonIndex(name); button.has_value())
+    {
+      controller->SetBindState(button.value(), parsed_value.value() != 0.0f ? 1.0f : 0.0f);
+    }
+    else if (const std::optional<u32> axis = GetAxisIndex(name); axis.has_value())
+    {
+      controller->SetBindState(axis.value(), std::clamp(parsed_value.value(), 0.0f, 1.0f));
+    }
+    else
+    {
+      SendError("unknown button or axis");
+      return;
+    }
+  }
+
+  SendText("OK\n");
+}
+
+void ClientSocket::ProcessCommand(std::string_view command)
+{
+  if (command.empty())
+    return;
+
+  const size_t space = command.find(' ');
+  const std::string_view verb = command.substr(0, space);
+  const std::string_view args = (space == std::string_view::npos) ? std::string_view() : Trim(command.substr(space + 1));
+
+  if (EqualsIgnoreCase(verb, "status"))
+  {
+    SendText(SmallString::from_format("OK paused={} running={} frames_remaining={} advance_remaining={}\n",
+                                      System::IsPaused() ? 1 : 0, System::IsValid() ? 1 : 0, s_frames_remaining,
+                                      s_ai_advance_remaining));
+  }
+  else if (EqualsIgnoreCase(verb, "pause"))
+  {
+    s_ai_advance_remaining = 0;
+    System::PauseSystem(true);
+    SendText("OK\n");
+  }
+  else if (EqualsIgnoreCase(verb, "resume"))
+  {
+    s_ai_advance_remaining = 0;
+    System::PauseSystem(false);
+    SendText("OK\n");
+  }
+  else if (EqualsIgnoreCase(verb, "advance"))
+  {
+    const std::optional<u32> frames = StringUtil::FromChars<u32>(args);
+    if (!frames.has_value() || frames.value() == 0)
+    {
+      SendError("advance requires a positive frame count");
+      return;
+    }
+
+    s_ai_advance_remaining = frames.value();
+    System::PauseSystem(false);
+    SendText("OK\n");
+  }
+  else if (EqualsIgnoreCase(verb, "buttons") || EqualsIgnoreCase(verb, "buttons2"))
+  {
+    SetButtons(args, EqualsIgnoreCase(verb, "buttons2") ? 1u : 0u);
+  }
+  else if (EqualsIgnoreCase(verb, "bind") || EqualsIgnoreCase(verb, "bind2"))
+  {
+    // bind[2] <index>=<value>...: the controller type's own bind indices
+    // (buttons, then its half axes), for types other than the digital pad.
+    Controller* const controller = Pad::GetController(EqualsIgnoreCase(verb, "bind2") ? 1u : 0u);
+    std::string_view rest = args;
+    while (controller && !rest.empty())
+    {
+      const size_t end = rest.find(' ');
+      const std::string_view token = rest.substr(0, end);
+      rest = (end == std::string_view::npos) ? std::string_view() : Trim(rest.substr(end + 1));
+      const size_t equals = token.find('=');
+      const std::optional<u32> index =
+        (equals == std::string_view::npos) ? std::nullopt : StringUtil::FromChars<u32>(token.substr(0, equals));
+      const std::optional<float> value =
+        index.has_value() ? StringUtil::FromChars<float>(token.substr(equals + 1)) : std::nullopt;
+      if (!value.has_value())
+      {
+        SendError("bind tokens must be index=value");
+        return;
+      }
+      controller->SetBindState(index.value(), value.value());
+    }
+    if (!controller)
+      SendError("controller is not connected");
+    else
+      SendText("OK\n");
+  }
+  else if (EqualsIgnoreCase(verb, "release") || EqualsIgnoreCase(verb, "release2"))
+  {
+    Controller* const controller = Pad::GetController(EqualsIgnoreCase(verb, "release2") ? 1u : 0u);
+    if (!controller)
+    {
+      SendError("pad 1 controller is not connected");
+      return;
+    }
+
+    for (u32 i = 0; i < static_cast<u32>(AnalogController::Button::Count); i++)
+      controller->SetBindState(i, 0.0f);
+    for (u32 i = 0; i < static_cast<u32>(AnalogController::HalfAxis::Count); i++)
+      controller->SetBindState(static_cast<u32>(AnalogController::Button::Count) + i, 0.0f);
+    SendText("OK\n");
+  }
+  else if (EqualsIgnoreCase(verb, "screenshot"))
+  {
+    SendScreenshot();
+  }
+  else if (EqualsIgnoreCase(verb, "vram"))
+  {
+    // dump full 1024x512 16-bit VRAM to the given path (raw little-endian u16)
+    std::string path(args);
+    std::FILE* fp = path.empty() ? nullptr : std::fopen(path.c_str(), "wb");
+    if (!fp)
+    {
+      SendError("vram requires a writable path");
+    }
+    else
+    {
+      std::fwrite(g_vram, 1, VRAM_SIZE, fp);
+      std::fclose(fp);
+      SendText("OK\n");
+    }
+  }
+  else if (EqualsIgnoreCase(verb, "spuram"))
+  {
+    std::string path(args);
+    std::FILE* fp = path.empty() ? nullptr : std::fopen(path.c_str(), "wb");
+    if (!fp)
+      SendError("spuram requires a writable path");
+    else
+    {
+      const auto& ram = SPU::GetRAM();
+      std::fwrite(ram.data(), 1, ram.size(), fp);
+      std::fclose(fp);
+      SendText("OK\n");
+    }
+  }
+  else if (EqualsIgnoreCase(verb, "audiodump"))
+  {
+    // audiodump <path>: append the mixed SPU output (raw 44100 Hz s16 stereo)
+    // to path from now on; audiodump without a path closes the file.
+    if (g_regtest_audio_dump)
+    {
+      std::fclose(g_regtest_audio_dump);
+      g_regtest_audio_dump = nullptr;
+    }
+    std::string path(args);
+    if (!path.empty() && !(g_regtest_audio_dump = std::fopen(path.c_str(), "wb")))
+      SendError("audiodump requires a writable path");
+    else
+      SendText("OK\n");
+  }
+  else if (EqualsIgnoreCase(verb, "disc"))
+  {
+    // disc <path>: swap the disc in the drive (a multi-disc game's "please set disc N").
+    std::string path(args);
+    if (path.empty() || !System::InsertMedia(path.c_str()))
+      SendError("disc requires a readable disc image");
+    else
+      SendText("OK\n");
+  }
+  else if (EqualsIgnoreCase(verb, "ticks"))
+  {
+    // ticks: the emulated system clock (global tick counter plus the CPU's
+    // pending ticks) and the frame number, e.g. at a GDB breakpoint stop.
+    SendText(SmallString::from_format("OK ticks={} frame={}\n",
+                                      TimingEvents::GetGlobalTickCounter() + CPU::GetPendingTicks(),
+                                      System::GetFrameNumber()));
+  }
+  else if (EqualsIgnoreCase(verb, "help"))
+  {
+    SendText("OK commands: status pause resume advance <frames> buttons[2] Name=value... release[2] screenshot help\n");
+  }
+  else
+  {
+    SendError("unknown command");
+  }
+}
+
+bool Initialize(u16 port)
+{
+  Error error;
+  const std::optional<SocketAddress> address =
+    SocketAddress::Parse(SocketAddress::Type::IPv4, "127.0.0.1", port, &error);
+  if (!address.has_value())
+  {
+    ERROR_LOG("Failed to parse AI control address: {}", error.GetDescription());
+    return false;
+  }
+
+  if (!(s_locals.multiplexer = SocketMultiplexer::Create(&error)))
+  {
+    ERROR_LOG("Failed to create AI control socket multiplexer: {}", error.GetDescription());
+    return false;
+  }
+
+  s_locals.listen_socket = s_locals.multiplexer->CreateListenSocket<ClientSocket>(address.value(), &error);
+  if (!s_locals.listen_socket)
+  {
+    ERROR_LOG("Failed to create AI control listen socket: {}", error.GetDescription());
+    s_locals.multiplexer.reset();
+    return false;
+  }
+
+  INFO_LOG("AI control server is now listening on {}.", address->ToString());
+  return true;
+}
+
+void Poll(u32 timeout_ms)
+{
+  if (s_locals.multiplexer)
+    s_locals.multiplexer->PollEventsWithTimeout(timeout_ms);
+}
+
+void Shutdown()
+{
+  while (!s_locals.clients.empty())
+  {
+    std::shared_ptr<ClientSocket> client = s_locals.clients.back();
+    client->Close();
+  }
+
+  if (s_locals.listen_socket)
+  {
+    s_locals.listen_socket->Close();
+    s_locals.listen_socket.reset();
+  }
+  s_locals.multiplexer.reset();
+}
+
+bool HasServer()
+{
+  return static_cast<bool>(s_locals.listen_socket);
+}
