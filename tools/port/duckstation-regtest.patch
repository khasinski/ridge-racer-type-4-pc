+void ClientSocket::OnConnected()
+{
+  INFO_LOG("AI control client {} connected.", GetRemoteAddress().ToString());
+  SetNagleBuffering(false);
+  s_locals.clients.push_back(std::static_pointer_cast<ClientSocket>(shared_from_this()));
+  SendText("OK ai-control ready\n");
+}
+
+void ClientSocket::OnDisconnected(const Error& error)
+{
+  INFO_LOG("AI control client {} disconnected: {}", GetRemoteAddress().ToString(), error.GetDescription());
+  const auto iter = std::find_if(s_locals.clients.begin(), s_locals.clients.end(),
+                                 [this](const std::shared_ptr<ClientSocket>& rhs) { return rhs.get() == this; });
+  if (iter != s_locals.clients.end())
+    s_locals.clients.erase(iter);
+}
+
+void ClientSocket::OnRead()
+{
+  const std::span<const u8> buffer = AcquireReadBuffer();
+  if (buffer.empty())
+    return;
+
+  m_pending_data.append(reinterpret_cast<const char*>(buffer.data()), buffer.size());
+  ReleaseReadBuffer(buffer.size());
+
+  for (;;)
+  {
+    const std::string::size_type newline = m_pending_data.find('\n');
+    if (newline == std::string::npos)
+      break;
+
+    std::string command = m_pending_data.substr(0, newline);
+    m_pending_data.erase(0, newline + 1);
+    if (!command.empty() && command.back() == '\r')
+      command.pop_back();
+
+    ProcessCommand(Trim(command));
+  }
+}
+
+void ClientSocket::SendText(std::string_view text)
+{
+  Write(text.data(), text.size());
+}
+
+void ClientSocket::SendError(std::string_view text)
+{
+  SmallString reply;
+  reply.format("ERR {}\n", text);
+  SendText(reply);
+}
+
+void ClientSocket::SendScreenshot()
+{
+  Image image;
+  u64 frame = 0;
+  {
+    std::unique_lock lock(s_latest_frame_mutex);
+    image = s_latest_frame;
+    frame = s_latest_frame_number;
+  }
+
+  if (!image.IsValid())
+  {
+    SendError("no screenshot available yet");
+    return;
+  }
+
+  const size_t size = image.GetStorageSize();
+  const SmallString header = SmallString::from_format("SCREENSHOT {} {} {} {} {}\n", image.GetWidth(),
+                                                       image.GetHeight(), image.GetPitch(), size, frame);
+  const void* buffers[] = {header.c_str(), image.GetPixels()};
+  const size_t lengths[] = {header.length(), size};
+  WriteVector(buffers, lengths, 2);
+}
