+static std::optional<u32> GetButtonIndex(std::string_view name)
+{
+  static constexpr std::pair<std::string_view, u32> BUTTONS[] = {
+    {"Select", static_cast<u32>(AnalogController::Button::Select)},
+    {"L3", static_cast<u32>(AnalogController::Button::L3)},
+    {"R3", static_cast<u32>(AnalogController::Button::R3)},
+    {"Start", static_cast<u32>(AnalogController::Button::Start)},
+    {"Up", static_cast<u32>(AnalogController::Button::Up)},
+    {"Right", static_cast<u32>(AnalogController::Button::Right)},
+    {"Down", static_cast<u32>(AnalogController::Button::Down)},
+    {"Left", static_cast<u32>(AnalogController::Button::Left)},
+    {"L2", static_cast<u32>(AnalogController::Button::L2)},
+    {"R2", static_cast<u32>(AnalogController::Button::R2)},
+    {"L1", static_cast<u32>(AnalogController::Button::L1)},
+    {"R1", static_cast<u32>(AnalogController::Button::R1)},
+    {"Triangle", static_cast<u32>(AnalogController::Button::Triangle)},
+    {"Circle", static_cast<u32>(AnalogController::Button::Circle)},
+    {"Cross", static_cast<u32>(AnalogController::Button::Cross)},
+    {"Square", static_cast<u32>(AnalogController::Button::Square)},
+    {"Analog", static_cast<u32>(AnalogController::Button::Analog)},
+  };
+
+  for (const auto& it : BUTTONS)
+  {
+    if (EqualsIgnoreCase(name, it.first))
+      return it.second;
+  }
+
+  return std::nullopt;
+}
