 }
 
+std::FILE* g_regtest_audio_dump = nullptr;
+
 namespace SPU {
 namespace {
 
@@ -865,6 +867,15 @@ u16 SPU::ReadRegister(u32 offset)
 
 void SPU::WriteRegister(u32 offset, u16 value)
 {
+  // Regtest: DUCKSTATION_SPU_REG_TRACE=1 logs CPU writes to the voice and
+  // voice-mask registers (0x000-0x19F) with the frame number.
+  static const bool reg_trace = [] {
+    const char* trace = std::getenv("DUCKSTATION_SPU_REG_TRACE");
+    return trace && *trace && *trace != '0';
+  }();
+  if (reg_trace && offset < 0x1A0)
+    std::fprintf(stderr, "DS-SPU reg frame=%u off=%03x val=%04x\n", System::GetFrameNumber(), offset, value);
+
   switch (offset)
   {
     case 0x1F801D80 - SPU_BASE:
@@ -1677,6 +1688,15 @@ CoreAudioStream& SPU::GetOutputStream()
 
 void SPU::Voice::KeyOn()
 {
+  if (std::getenv("DUCKSTATION_SPU_KEY_TRACE"))
+  {
+    const std::ptrdiff_t index = this - s_state.voices.data();
+    std::fprintf(stderr,
+                 "DS-SPU key-on voice=%td addr=%u repeat=%u pitch=%u left=%d right=%d adsr1=%u adsr2=%u\n",
+                 index, regs.adpcm_start_address, regs.adpcm_repeat_address, regs.adpcm_sample_rate,
+                 static_cast<s16>(regs.volume_left.bits), static_cast<s16>(regs.volume_right.bits),
+                 static_cast<u16>(regs.adsr.bits), static_cast<u16>(regs.adsr.bits >> 16));
+  }
   current_address = regs.adpcm_start_address & ~u16(1);
   counter.bits = 0;
   regs.adsr_volume = 0;
@@ -1695,6 +1715,8 @@ void SPU::Voice::KeyOn()
 
 void SPU::Voice::KeyOff()
 {
+  if (std::getenv("DUCKSTATION_SPU_KEY_TRACE"))
+    std::fprintf(stderr, "DS-SPU key-off voice=%td\n", this - s_state.voices.data());
   if (adsr_phase == ADSRPhase::Off || adsr_phase == ADSRPhase::Release)
     return;
 
@@ -1932,6 +1954,13 @@ void SPU::Voice::DecodeBlock(const ADPCMBlock& block)
 
   std::copy(last_samples, last_samples + countof(last_samples), adpcm_last_samples.begin());
   current_block_flags.bits = block.flags.bits;
+  if (std::getenv("DUCKSTATION_ADPCM_DUMP") && (this - s_state.voices.data()) == 18)
+  {
+    static std::FILE* dump = std::fopen(std::getenv("DUCKSTATION_ADPCM_DUMP"), "wb");
+    if (dump)
+      std::fwrite(&current_block_samples[NUM_SAMPLES_FROM_LAST_ADPCM_BLOCK], sizeof(s16),
+                  NUM_SAMPLES_PER_ADPCM_BLOCK, dump);
+  }
 }
 
 s32 SPU::Voice::Interpolate() const
@@ -2429,6 +2458,18 @@ void SPU::Execute(void* param, TickCount ticks)
       for (u32 voice = 0; voice < NUM_VOICES; voice++)
       {
         const auto [left, right] = SampleVoice(voice);
+        if (voice == 18)
+        {
+          static std::FILE* dump = []() -> std::FILE* {
+            const char* path = std::getenv("DUCKSTATION_VOICE18_DUMP");
+            return (path && *path) ? std::fopen(path, "wb") : nullptr;
+          }();
+          if (dump)
+          {
+            const s16 sample = static_cast<s16>(Clamp16(s_state.voices[voice].last_volume));
+            std::fwrite(&sample, sizeof(sample), 1, dump);
+          }
+        }
         left_sum += left;
         right_sum += right;
 
@@ -2531,6 +2572,10 @@ void SPU::Execute(void* param, TickCount ticks)
       }
