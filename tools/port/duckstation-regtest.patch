+static std::optional<u32> GetAxisIndex(std::string_view name)
+{
+  static constexpr u32 HALF_AXIS_START = static_cast<u32>(AnalogController::Button::Count);
+  static constexpr std::pair<std::string_view, u32> AXES[] = {
+    {"LLeft", HALF_AXIS_START + static_cast<u32>(AnalogController::HalfAxis::LLeft)},
+    {"LRight", HALF_AXIS_START + static_cast<u32>(AnalogController::HalfAxis::LRight)},
+    {"LDown", HALF_AXIS_START + static_cast<u32>(AnalogController::HalfAxis::LDown)},
+    {"LUp", HALF_AXIS_START + static_cast<u32>(AnalogController::HalfAxis::LUp)},
+    {"RLeft", HALF_AXIS_START + static_cast<u32>(AnalogController::HalfAxis::RLeft)},
+    {"RRight", HALF_AXIS_START + static_cast<u32>(AnalogController::HalfAxis::RRight)},
+    {"RDown", HALF_AXIS_START + static_cast<u32>(AnalogController::HalfAxis::RDown)},
+    {"RUp", HALF_AXIS_START + static_cast<u32>(AnalogController::HalfAxis::RUp)},
+  };
+
+  for (const auto& it : AXES)
